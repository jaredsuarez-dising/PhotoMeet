{
    "version": 2,
    "builds": [
        {
            "src": "*.html",
            "use": "@vercel/static"
        },
        {
            "src": "js/*.js",
            "use": "@vercel/static"
        },
        {
            "src": "styles/*.css",
            "use": "@vercel/static"
        },
        {
            "src": "components/*.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/components/(.*)",
            "dest": "/components/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/js/$1"
        },
        {
            "src": "/styles/(.*)",
            "dest": "/styles/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
} 